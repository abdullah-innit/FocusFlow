<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.focusflow.SecondaryController"
      alignment="CENTER" spacing="20"
      style="-fx-background-color: #1a1a2e; -fx-padding: 40;">

    <Text text="Session History"
          style="-fx-fill: #e94560; -fx-font-size: 28; -fx-font-weight: bold;"/>

    <Label fx:id="totalSessionsLabel" text="Total Sessions: 0"
           style="-fx-text-fill: white; -fx-font-size: 14;"/>

    <Label fx:id="totalTimeLabel" text="Total Focus Time: 0 mins"
           style="-fx-text-fill: white; -fx-font-size: 14;"/>

    <ListView fx:id="historyList" prefWidth="400" prefHeight="300"
              style="-fx-background-color: #16213e;
                     -fx-control-inner-background: #16213e;"/>

    <Button text="⬅ Back to Timer" onAction="#switchToTimer"
            style="-fx-background-color: #e94560; -fx-text-fill: white;
                   -fx-font-size: 14; -fx-padding: 10 30;
                   -fx-background-radius: 25; -fx-cursor: hand;"/>

</VBox>